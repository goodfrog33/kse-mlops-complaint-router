# Copy to .env (make env does it). Local-only credentials for the Docker stack.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
POSTGRES_PASSWORD=postgres
# Host-side clients (training, dvc, reproduce)
MLFLOW_TRACKING_URI=http://localhost:5050
WAREHOUSE_DSN=postgresql://complaints:complaints@localhost:5442/warehouse
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
# MLflow 3 clients download artifacts via presigned URLs naming minio:9000, which the
# host cannot resolve; force downloads through the tracking server instead.
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MLFLOW_DISABLE_AGENT_HINT=1
